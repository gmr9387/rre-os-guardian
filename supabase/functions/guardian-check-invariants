// supabase/functions/guardian-check-invariants/index.ts
// Guardian Invariant Engine — Generation 1
//
// Checks correctness across:
//   - guardian_candidates
//   - guardian_executions
//   - guardian_stopouts
//   - guardian_trades
//   - guardian_equity
//   - guardian_kill_switch
//   - guardian_settings
//   - guardian_repairs

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async () => {
  const invariants: any[] = [];

  // 1. Missing settings
  const { data: accounts } = await supabase
    .from("guardian_accounts")
    .select("id");

  for (const acc of accounts) {
    const { data: settings } = await supabase
      .from("guardian_settings")
      .select("id")
      .eq("account_id", acc.id)
      .single();

    if (!settings) {
      invariants.push({
        type: "missing-settings",
        account_id: acc.id,
        severity: "high",
      });
    }
  }

  // 2. Missing kill switch rows
  for (const acc of accounts) {
    const { data: ks } = await supabase
      .from("guardian_kill_switch")
      .select("id")
      .eq("account_id", acc.id)
      .single();

    if (!ks) {
      invariants.push({
        type: "missing-kill-switch",
        account_id: acc.id,
        severity: "high",
      });
    }
  }

  // 3. Orphaned candidates (no account)
  const { data: candidates } = await supabase
    .from("guardian_candidates")
    .select("id, account_id");

  for (const c of candidates) {
    const exists = accounts.some((a) => a.id === c.account_id);
    if (!exists) {
      invariants.push({
        type: "orphaned-candidate",
        candidate_id: c.id,
        severity: "medium",
      });
    }
  }

  // 4. Orphaned executions
  const { data: executions } = await supabase
    .from("guardian_executions")
    .select("id, candidate_id");

  for (const e of executions) {
    const exists = candidates.some((c) => c.id === e.candidate_id);
    if (!exists) {
      invariants.push({
        type: "orphaned-execution",
        execution_id: e.id,
        severity: "medium",
      });
    }
  }

  // 5. Invalid execution states
  const validStates = ["pending", "authorized", "executed", "rejected", "cancelled"];

  for (const e of executions) {
    if (!validStates.includes(e.state)) {
      invariants.push({
        type: "invalid-execution-state",
        execution_id: e.id,
        state: e.state,
        severity: "high",
      });
    }
  }

  // 6. Stuck candidates (pending > 24h)
  const now = Date.now();
  for (const c of candidates) {
    const created = new Date(c.created_at).getTime();
    if (c.status === "pending" && now - created > 24 * 3600 * 1000) {
      invariants.push({
        type: "candidate-stuck",
        candidate_id: c.id,
        severity: "medium",
      });
    }
  }

  // 7. Stuck executions (authorized > 12h)
  for (const e of executions) {
    const created = new Date(e.created_at).getTime();
    if (e.state === "authorized" && now - created > 12 * 3600 * 1000) {
      invariants.push({
        type: "execution-stuck",
        execution_id: e.id,
        severity: "high",
      });
    }
  }

  return new Response(JSON.stringify({ invariants }), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
});
