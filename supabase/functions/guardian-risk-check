// supabase/functions/guardian-risk-check/index.ts
// Guardian Backend — Risk Check (Generation 1)
//
// Purpose:
//   Evaluate whether a candidate is allowed to proceed to execution.
//   Checks:
//     - Kill switch
//     - Account mode restrictions
//     - Daily loss limits
//     - Max re-entries per day
//     - Candidate score thresholds
//
// Input:
//   {
//     candidate_id: string
//   }
//
// Output:
//   {
//     status: "risk-evaluated",
//     allowed: boolean,
//     reason: string
//   }

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

serve(async (req) => {
  try {
    const body = await req.json();
    const { candidate_id } = body;

    if (!candidate_id) {
      return new Response(
        JSON.stringify({
          error: "missing-candidate-id",
        }),
        { status: 400 }
      );
    }

    // Load candidate
    const { data: candidate, error: candidateError } = await supabase
      .from("guardian_candidates")
      .select("*")
      .eq("id", candidate_id)
      .single();

    if (candidateError || !candidate) {
      return new Response(
        JSON.stringify({
          error: "candidate-not-found",
          details: candidateError?.message,
        }),
        { status: 404 }
      );
    }

    const account_id = candidate.account_id;

    // Load kill switch
    const { data: killSwitch } = await supabase
      .from("guardian_kill_switch")
      .select("*")
      .eq("account_id", account_id)
      .single();

    if (killSwitch?.enabled) {
      return new Response(
        JSON.stringify({
          status: "risk-evaluated",
          allowed: false,
          reason: "Kill switch enabled",
        }),
        { status: 200 }
      );
    }

    // Load settings
    const { data: settings } = await supabase
      .from("guardian_settings")
      .select("*")
      .eq("account_id", account_id)
      .single();

    // Load today's trades for daily loss check
    const today = new Date().toISOString().split("T")[0];

    const { data: tradesToday } = await supabase
      .from("guardian_trades")
      .select("pnl")
      .eq("account_id", account_id)
      .gte("closed_at", `${today}T00:00:00`)
      .lte("closed_at", `${today}T23:59:59`);

    const dailyLoss = tradesToday?.reduce((acc, t) => acc + (t.pnl || 0), 0) || 0;

    if (settings?.max_daily_loss_pct && dailyLoss < 0) {
      const equitySnapshot = await supabase
        .from("guardian_equity")
        .select("equity")
        .eq("account_id", account_id)
        .order("captured_at", { ascending: false })
        .limit(1)
        .single();

      const equity = equitySnapshot.data?.equity || 0;
      const lossPct = Math.abs(dailyLoss) / equity * 100;

      if (lossPct >= settings.max_daily_loss_pct) {
        return new Response(
          JSON.stringify({
            status: "risk-evaluated",
            allowed: false,
            reason: "Daily loss limit exceeded",
          }),
          { status: 200 }
        );
      }
    }

    // Max re-entries per day
    const { data: candidatesToday } = await supabase
      .from("guardian_candidates")
      .select("id")
      .eq("account_id", account_id)
      .gte("created_at", `${today}T00:00:00`)
      .lte("created_at", `${today}T23:59:59`);

    if (
      settings?.max_reentries_day &&
      candidatesToday.length >= settings.max_reentries_day
    ) {
      return new Response(
        JSON.stringify({
          status: "risk-evaluated",
          allowed: false,
          reason: "Max re-entries reached for today",
        }),
        { status: 200 }
      );
    }

    // Score threshold
    if (candidate.score < 55) {
      return new Response(
        JSON.stringify({
          status: "risk-evaluated",
          allowed: false,
          reason: "Score too low",
        }),
        { status: 200 }
      );
    }

    // Confidence threshold
    if (candidate.confidence < 40) {
      return new Response(
        JSON.stringify({
          status: "risk-evaluated",
          allowed: false,
          reason: "Confidence too low",
        }),
        { status: 200 }
      );
    }

    // Mode restrictions
    if (settings?.mode === "safe" && candidate.risk === "aggressive") {
      return new Response(
        JSON.stringify({
          status: "risk-evaluated",
          allowed: false,
          reason: "Aggressive candidate blocked in safe mode",
        }),
        { status: 200 }
      );
    }

    // If all checks pass
    return new Response(
      JSON.stringify({
        status: "risk-evaluated",
        allowed: true,
        reason: "Risk checks passed",
      }),
      { status: 200 }
    );
  } catch (err) {
    return new Response(
      JSON.stringify({
        error: "invalid-json",
        details: String(err),
      }),
      { status: 400 }
    );
  }
});
