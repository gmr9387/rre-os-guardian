// supabase/functions/guardian-repair-state/index.ts
// Guardian Repair Engine — Generation 1
//
// Repairs:
//   - missing settings
//   - missing kill switch
//   - orphaned candidates
//   - orphaned executions
//   - invalid execution states
//   - stuck candidates
//   - stuck executions

import { serve } from "https://deno.land/std@0.168.0/http/server.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const supabase = createClient(
  Deno.env.get("SUPABASE_URL")!,
  Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!
);

async function logRepair(account_id: string, type: string, details: any) {
  await supabase.from("guardian_repairs").insert({
    account_id,
    type,
    details,
    repaired_at: new Date().toISOString(),
  });
}

serve(async (req) => {
  const { invariants } = await req.json();
  const repairs: any[] = [];

  for (const inv of invariants) {
    switch (inv.type) {
      case "missing-settings":
        await supabase.from("guardian_settings").insert({
          account_id: inv.account_id,
          max_reentries_day: 5,
          max_daily_loss_pct: 10,
        });
        await logRepair(inv.account_id, "missing-settings", inv);
        repairs.push(inv);
        break;

      case "missing-kill-switch":
        await supabase.from("guardian_kill_switch").insert({
          account_id: inv.account_id,
          enabled: false,
        });
        await logRepair(inv.account_id, "missing-kill-switch", inv);
        repairs.push(inv);
        break;

      case "orphaned-candidate":
        await supabase
          .from("guardian_candidates")
          .update({ status: "expired" })
          .eq("id", inv.candidate_id);
        await logRepair(null, "orphaned-candidate", inv);
        repairs.push(inv);
        break;

      case "orphaned-execution":
        await supabase
          .from("guardian_executions")
          .update({ state: "cancelled" })
          .eq("id", inv.execution_id);
        await logRepair(null, "orphaned-execution", inv);
        repairs.push(inv);
        break;

      case "invalid-execution-state":
        await supabase
          .from("guardian_executions")
          .update({ state: "cancelled" })
          .eq("id", inv.execution_id);
        await logRepair(null, "invalid-execution-state", inv);
        repairs.push(inv);
        break;

      case "candidate-stuck":
        await supabase
          .from("guardian_candidates")
          .update({ status: "expired" })
          .eq("id", inv.candidate_id);
        await logRepair(null, "candidate-stuck", inv);
        repairs.push(inv);
        break;

      case "execution-stuck":
        await supabase
          .from("guardian_executions")
          .update({ state: "cancelled" })
          .eq("id", inv.execution_id);
        await logRepair(null, "execution-stuck", inv);
        repairs.push(inv);
        break;
    }
  }

  return new Response(JSON.stringify({ repairs }), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
});
